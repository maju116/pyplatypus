__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.venv/
.idea/
.ipynb_checkpoints/

# Leading slashes matter. An unanchored "data/" also matches pyplatypus/data/ and
# tests/data/, which quietly dropped the whole data layer from a commit once already.

# Datasets and run artefacts never belong in the repo.
/examples/data/
/examples/output/
*.h5
*.hdf5
*.safetensors
*.pt
*_history.csv

# Generated at build time from the pydantic models, see spec/schema.py
/schema/*.json

# --- left over from the pre-rewrite package, still on disk, deliberately not tracked ---
# The bulls dataset: 2239 files, 59 MB, and it was never in git before either.
/data/
# mkdocs site for the package being replaced; docs are rebuilt in step 8.
/docs/
/development_script.py
/_legacy/

# Examples written against the pre-rewrite schema; they would not validate today.
/examples/*.ipynb
/examples/*.csv
/examples/siim_acr.yml
/examples/data_science_bowl_config.yaml
/examples/claud_38_config.yaml

# Trained weights. They belong on the Hub with a model card, not in the source tree - and the
# publishing script writes here by default.
/weights/

# What the examples measure. Three of them write a run record, a table and figures here by
# default, so a reader who runs one should not be shown a dirty tree - and a results file
# committed by accident once already read as the measurement when it was the smoke test.
/measurements/

/.quarto/
**/*.quarto_ipynb

# The documentation site: `docs/` is the built output, deployed to gh-pages, and
# `reference/` is what quartodoc generates from the docstrings. Both come out of
# `tools/build_reference.py` plus a build, so neither belongs in history - the same
# reasoning as the R package, where tracking altdoc's generated metadata would have put a
# timestamp and the building machine's pandoc version into every commit.
/docs/
/reference/
# Generated at docs-build time by tools/build_config_reference.py. Not committed: it has one
# consumer, the renderer, so there is nothing a staleness test could catch that a build would
# not - unlike _quarto.yml, which two things have to agree about.
/config.qmd
# Rendered from CITATION.cff, which is the committed source.
/CITATION.qmd
# quartodoc writes this inventory beside the reference it generates.
/objects.json
